PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
# The account registered with this email becomes the Developer/Admin
ADMIN_EMAIL=abdulraufadamolugbon@gmail.com

# Paystack (Dashboard > Settings > API Keys). Use sk_test_ first.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Use "test-bank" in test mode, "wema-bank" or "titan-paystack" live
PAYSTACK_BANK=test-bank

# VTU provider (VTpass adapter). Sandbox: https://sandbox.vtpass.com  Live: https://vtpass.com
VTPASS_BASE=https://sandbox.vtpass.com
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
# true = simulate successful purchases (no real provider call). Set false to go live.
MOCK_VTU=true

# Public address of your deployed site (Paystack sends people back here after card payment)
APP_URL=https://your-domain.com

# Email receipts (SMTP). Gmail: turn on 2-step verification, create an App Password, use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM="DATA 4 UMMAH <yourgmail@gmail.com>"
